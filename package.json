    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.26",
    "playwright": "^1.62.0",
    "postcss": "^8.5.3",
