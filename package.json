{
  "name": "eternal-fitness",
  "version": "3.11.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:fix-points": "bun run scripts/fix-points.ts",
    "db:reset-training-hours": "bun run scripts/reset-training-hours.ts",
    "db:backfill-e1rm": "bun run scripts/backfill-e1rm.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "docker:build": "docker build -t zenatron/eternal-fitness:v$npm_package_version -t zenatron/eternal-fitness:latest .",
    "docker:push": "docker push zenatron/eternal-fitness:v$npm_package_version && docker push zenatron/eternal-fitness:latest",
    "docker:release": "bun run docker:build && bun run docker:push"
  },
  "devDependencies": {
    "@types/node": "^20.17.27",
