# Database
DATABASE_URL=postgresql://eternal:eternal@localhost:5433/eternal_fitness

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=generate-a-random-secret-here
# Public URL of your app — required in production, e.g. https://fitness.mydomain.me
#
# Leave this UNSET for local development. Auth.js resolves sign-in/out redirects
# against it, so a hardcoded localhost value breaks testing from a phone on the
# LAN; `trustHost: true` derives the origin from the request instead.
# AUTH_URL=https://fitness.example.com

# PocketID OIDC Client — from your existing PocketID instance
AUTH_POCKETID_ID=your-pocketid-client-id
AUTH_POCKETID_SECRET=your-pocketid-client-secret
AUTH_POCKETID_ISSUER=https://your-pocketid-instance.example.com

# Dev auth bypass — set to true to skip PocketID during local development
# Creates a mock user session instantly. NEVER enable in production.
AUTH_DEV_BYPASS=false
NEXT_PUBLIC_AUTH_DEV_BYPASS=false

# Web Push (optional) — generate with: bun run scripts/generate-vapid-keys.mjs
# Leave blank to disable push; the app degrades gracefully and hides the toggle.
# Runtime-only: the public key is served by GET /api/push/subscribe, so rotating
# the keypair is a restart, not an image rebuild.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
